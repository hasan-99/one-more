{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "channel": "preview"
    },
    "preview-device": {
      "extends": "preview",
      "ios": {
        "simulator": false
      },
      "channel": "preview-device"
    }
  }
}
